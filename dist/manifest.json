{
  "manifest_version": 3,
  "name": "Ultra Browser",
  "version": "0.1.0",
  "description": "Navegador de próxima geração com inteligência artificial integrada.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Abrir Ultra Browser"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
